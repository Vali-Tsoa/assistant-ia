# ===== LLM Configuration =====
# Choisir : "openai" | "ollama" | "groq" | "gemini"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-pro

# Gemini (si LLM_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-key-here

# OpenAI (si LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-key-here

# Groq (si LLM_PROVIDER=groq)
GROQ_API_KEY=your-groq-key-here

# Ollama base URL (si local)
OLLAMA_BASE_URL=http://localhost:11434

# ===== Embedding =====
# "huggingface" (local, gratuit) | "openai"
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ===== Database =====
DATABASE_URL=sqlite:///./maintenance_ia.db

# ===== ChromaDB =====
CHROMA_PERSIST_DIR=./chroma_db

# ===== Application =====
APP_NAME=mAIntenance Assistant
APP_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ===== Security =====
SECRET_KEY=your-secret-key-change-in-production
